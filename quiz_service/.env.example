# Finelo Quiz Service — Environment Variables
# Copy to .env and fill in values for local development

APP_NAME=quiz-service
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quiz_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
QUIZ_CACHE_TTL=60

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=finelo.events
RABBITMQ_ROUTING_KEY=quiz.questions.rewarded

OUTBOX_POLL_INTERVAL=2.0
OUTBOX_BATCH_SIZE=50

RATE_LIMIT_PER_MINUTE=60
