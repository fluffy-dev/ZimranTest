APP_TITLE="Finelo Quiz Service"
APP_DESCRIPTION="Microservice for managing and grading quizzes."
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=False
APP_HOOKS_ENABLED=True
APP_ROOT_PATH=""
APP_TIMEZONE_SHIFT=3

DB_URL_SCHEME=postgresql+asyncpg
DB_HOST=quiz_db
DB_PORT=5432
DB_NAME=quiz_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_ECHO_LOG=False
DB_RUN_AUTO_MIGRATE=True

LOGGING_ON=True
LOGGING_LEVEL=INFO
LOGGING_JSON=False

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_EXPOSE_HEADERS=*
CORS_MAX_AGE=600

APP_DOCS_URL=/docs
APP_REDOC_URL=/redoc
APP_SUMMARY="Project Summary"
APP_TERMS_OF_SERVICE=
APP_LICENSE_NAME=MIT
APP_LICENSE_IDENTIFIER=MIT
APP_LICENSE_URL=https://rem.mit-license.org/license.txt
APP_CONTACT_NAME="John Doe"
APP_CONTACT_URL=https://example.com
APP_CONTACT_EMAIL=John@Doe.com

REDIS_URL=redis://redis:6379/0
QUIZ_CACHE_TTL=60

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=finelo.events
RABBITMQ_ROUTING_KEY=quiz.questions.rewarded

OUTBOX_POLL_INTERVAL=2.0
OUTBOX_BATCH_SIZE=50

ATTEMPT_ABANDON_POLL_INTERVAL=60.0
ATTEMPT_ABANDON_TIMEOUT_MINUTES=60

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
