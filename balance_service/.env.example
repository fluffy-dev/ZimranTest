APP_TITLE="Finelo Balance Service"
APP_DESCRIPTION="Manages user virtual currency balances."
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=False
APP_HOOKS_ENABLED=True
APP_ROOT_PATH=""
APP_TIMEZONE_SHIFT=5

DB_URL_SCHEME=postgresql+asyncpg
DB_HOST=balance_db
DB_PORT=5432
DB_NAME=balance_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_ECHO_LOG=False
DB_RUN_AUTO_MIGRATE=True

LOGGING_ON=True
LOGGING_LEVEL=INFO
LOGGING_JSON=False

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_EXPOSE_HEADERS=*
CORS_MAX_AGE=600

APP_DOCS_URL=/docs
APP_REDOC_URL=/redoc
APP_SUMMARY="Project Summary"
APP_TERMS_OF_SERVICE=
APP_LICENSE_NAME=MIT
APP_LICENSE_IDENTIFIER=MIT
APP_LICENSE_URL=https://rem.mit-license.org/license.txt
APP_CONTACT_NAME="John Doe"
APP_CONTACT_URL=https://example.com
APP_CONTACT_EMAIL=John@Doe.com

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=finelo.events
RABBITMQ_QUEUE=balance.quiz_reward
RABBITMQ_ROUTING_KEY=quiz.questions.rewarded

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
