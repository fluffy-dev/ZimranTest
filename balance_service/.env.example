# Finelo Balance Service — Environment Variables

APP_NAME=balance-service
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/balance_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=finelo.events
RABBITMQ_QUEUE=balance.quiz_reward
RABBITMQ_ROUTING_KEY=quiz.questions.rewarded
